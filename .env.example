# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# See docs/security.md for the secret-handling policy.

# --- JWT ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- PostgreSQL container ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend ---
# Inside Docker Compose use host `postgres_db`; locally use `localhost`.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# --- Frontend build arg ---
REACT_APP_API_URL=http://localhost:8000

# --- Tests ---
TEST_DATABASE_URL=

# --- Optional email (empty = disabled) ---
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- Deployment (CD workflows / scripts/deploy.sh) ---
# Immutable image tag deployed by CD, e.g. ghcr.io/<owner>/<repo>/ems-api:<sha>
IMAGE_TAG=
# Previously known-good tag used by scripts/rollback.sh
PREVIOUS_IMAGE_TAG=
